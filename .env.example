# URL pública del sitio (sin "/" final). Se usa en metadata, Open Graph, sitemap y robots.
# Ejemplo: https://www.nuvexa.co
NEXT_PUBLIC_SITE_URL=

# Correo público de contacto (pie de página, /contacto y respaldo del formulario).
# Usa un correo del dominio, p. ej. contacto@nuvexa.co. Si está vacío se usa el correo provisional.
NEXT_PUBLIC_CONTACT_EMAIL=

# Opcional: URL que recibe las solicitudes del formulario de contacto (POST JSON).
# Sirve para Make, n8n, Zapier, un CRM o una API propia.
# Si está vacía, el formulario NO envía nada e invita a escribir por correo.
LEADS_WEBHOOK_URL=
