# OBLIGATORIA en producción: URL pública del sitio, con https:// y sin ruta.
# Se usa en metadata, canonical, Open Graph, sitemap y robots.
# El build de producción falla si falta, no usa https o apunta a localhost.
# Formato: https://<dominio>
NEXT_PUBLIC_SITE_URL=

# OBLIGATORIA en producción: correo de contacto que se muestra en el sitio
# (pie de página, /contacto y respaldo del formulario). Usa un correo del dominio.
# Se lee en el servidor (sin prefijo NEXT_PUBLIC_) y se publica en el HTML: no es un secreto.
# En Vercel puede guardarse como tipo Config. El build de producción falla si falta o no es válido.
CONTACT_EMAIL=

# ── Destino del formulario de contacto ──────────────────────────────────────────
# Todas son SOLO del servidor: nunca les pongas el prefijo NEXT_PUBLIC_.
# Se usa el primer destino configurado: 1) correo con Resend, 2) webhook.
# Si no hay ninguno, el formulario NO envía nada e invita a escribir por correo.

# Clave de API de Resend (https://resend.com → API Keys, permiso "Sending access").
# No la guardes en el repositorio: solo en .env.local o en las variables de Vercel.
RESEND_API_KEY=

# Correo(s) que reciben las solicitudes, separados por comas (máx. 5).
LEADS_EMAIL_TO=

# Opcional: remitente. Vacío = "NUVEXA <onboarding@resend.dev>", que Resend solo entrega
# al correo con el que se creó la cuenta de Resend. Para otros destinatarios, verifica un
# dominio en Resend y usa una dirección de ese dominio, p. ej. NUVEXA <solicitudes@<dominio>>.
LEADS_EMAIL_FROM=

# Alternativa a Resend: URL que recibe las solicitudes (POST JSON) — Make, n8n, Zapier,
# un CRM o una API propia. Solo se usa si RESEND_API_KEY está vacía. Contrato en README.md.
LEADS_WEBHOOK_URL=
